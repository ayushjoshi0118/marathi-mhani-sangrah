# ==============================================================================
# मराठी म्हणी संग्रह — Marathi Mhani Sangrah
# Production Environment Configuration Template
# ==============================================================================

# Public Web Domain URL (Used for generating canonical OpenGraph tags and XML sitemap)
NEXT_PUBLIC_SITE_URL=https://marathi-mhani-sangrah.org

# Protected Editorial / Admin Dashboard Secret Key
# REQUIRED FOR PRODUCTION: Change this to a strong, high-entropy 32+ character secret
ADMIN_SECRET_KEY=replace_with_a_secure_random_key_in_production

# Node Environment
NODE_ENV=production

# ------------------------------------------------------------------------------
# Optional: Managed PostgreSQL / Supabase Integration
# If connecting to an external PostgreSQL / Supabase cluster, configure below:
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY=your_private_service_role_key_here
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_ID].supabase.co:5432/postgres
